# ==============================================================================
# CreditMera - Render Cloud Deployment Configuration Reference
# Use these environment variables when setting up services on Render.com
# ==============================================================================

# ------------------------------------------------------------------------------
# SECTION A: BACKEND WEB SERVICE ENVIRONMENT VARIABLES
# Add these in the Render Dashboard under:
# Your Backend Service -> "Environment" -> "Add Environment Variable"
# ------------------------------------------------------------------------------

# 1. Environment & Runtime
ENVIRONMENT=production
PYTHON_VERSION=3.11.10
APP_NAME=CreditMera
APP_VERSION=1.0.0
ALGORITHM_VERSION=v1.0-dct-svd

# 2. Database Connection
# If using Render's Managed PostgreSQL:
# Render automatically provides DATABASE_URL in the format:
# postgresql://creditmera:password@dpg-xxxxx.oregon-postgres.render.com/creditmera_db
# (The CreditMera backend automatically normalizes postgres:// and postgresql://)
DATABASE_URL=postgresql://creditmera:password@your-render-db-host.render.com/creditmera_db

# 3. Cryptographic Secret Keys (Pre-generated 64-character secure hex keys)
# You can use these immediately or generate new ones using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=0f7f954da038cbd17b9e16ac6ebc533b7c7647e1fe83d53dd6d8d0609f0ba336
WATERMARK_SECRET_KEY=318820f7e37c03996a832d3fcde75e5342e366b3b178075a3ad48e3cc3b4810a

# 4. Storage Provider
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/tmp/storage_data

# 5. Security & CORS (Allows your frontend on any domain or phone to communicate with backend)
CORS_ORIGINS=*

# 6. Upload Size Limit (32MB)
MAX_CONTENT_LENGTH_BYTES=33554432


# ------------------------------------------------------------------------------
# SECTION B: FRONTEND STATIC SITE ENVIRONMENT VARIABLES
# Add these in the Render Dashboard under:
# Your Frontend Static Site -> "Environment" -> "Add Environment Variable"
# ------------------------------------------------------------------------------

# Replace with your actual deployed Render Backend URL (no trailing slash):
# Example: https://creditmera-backend.onrender.com
VITE_API_BASE_URL=https://creditmera-backend.onrender.com
