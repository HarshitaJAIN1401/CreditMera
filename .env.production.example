# ==============================================================================
# CreditMera - Production Environment Configuration Reference (.env)
# COPY TO .env OR SET VIA PRODUCTION SECRET STORE (AWS Secrets Manager, Vault, etc.)
# NEVER COMMIT REAL PRODUCTION CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# 1. Environment & Application
ENVIRONMENT=production
APP_NAME=CreditMera
APP_VERSION=1.0.0
ALGORITHM_VERSION=1.0.0

# 2. Database Configuration (PostgreSQL 16)
# Generate a strong, unique password: python -c "import secrets; print(secrets.token_urlsafe(24))"
CREDITMERA_DB_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD_MIN_16_CHARS
DATABASE_URL=postgresql+psycopg2://creditmera:REPLACE_WITH_STRONG_POSTGRES_PASSWORD_MIN_16_CHARS@db:5432/creditmera_db

# 3. Cryptographic Secret Keys (MANDATORY in Production)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
# Must be at least 32 characters; default dev values will be REJECTED at startup!
SECRET_KEY=REPLACE_WITH_MINIMUM_64_CHAR_HEX_SECRET_FOR_JWT_AND_RECEIPTS
WATERMARK_SECRET_KEY=REPLACE_WITH_MINIMUM_64_CHAR_HEX_SECRET_FOR_DCT_SVD_PERMUTATION

# 4. Storage Provider Configuration
# Supported backends: 'local' (filesystem volume) or 's3' (AWS S3 / MinIO / Cloudflare R2)
STORAGE_BACKEND=local
STORAGE_LOCAL_BASE_DIR=/app/storage_data

# Optional S3 Settings (Used only if STORAGE_BACKEND=s3):
# S3_BUCKET_NAME=my-creditmera-production-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY_ID=REPLACE_WITH_IAM_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=REPLACE_WITH_IAM_SECRET_KEY
# S3_PREFIX=assets
# S3_PRESIGNED_EXPIRY_SECONDS=900

# 5. Security, Networking & CORS
# Comma-separated list of fully qualified public domain names allowed to query the API
CORS_ORIGINS=https://creditmera.yourdomain.com,https://api.creditmera.yourdomain.com

# Upload Size Limits (Bytes) - default is 32MB
MAX_CONTENT_LENGTH_BYTES=33554432

# 6. Verification & Embedding Calibration Parameters
DEFAULT_ALGORITHM=dct_svd
DEFAULT_ALPHA=0.10
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=8192
RECEIPT_ISSUER=CreditMera Authority
