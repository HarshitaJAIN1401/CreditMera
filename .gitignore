# ==============================================================================
# CreditMera .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.so

# C extensions & build artifacts
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
.env.bak/
.pdm-python
.pixi/

# Testing & Coverage
.cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
.hypothesis/
.ruff_cache/
.mypy_cache/

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.cert
*.pfx

# Databases & local persistent state
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal

# Local storage, uploads, and data directories
storage_data/
storage/uploads/
uploads/
temp_uploads/
scratch/

# Research & Experiments - Datasets and raw binary outputs
experiments/datasets/*
!experiments/datasets/.gitkeep
experiments/results/raw/*
!experiments/results/raw/.gitkeep
experiments/results/plots/*
!experiments/results/plots/.gitkeep

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.oxlintrc.json
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor settings
.idea/
.vscode/
*.swp
*.swo
*~
tempCodeRunnerFile.py

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Academic Submission Deliverables & Evaluation Documentation (Local Only)
CreditMera_Final_Project_Report.*
CreditMera_Final_Presentation.*
CreditMera_Viva_Preparation.*
CreditMera_Live_Demo_Script.*
CreditMera_Submission_Checklist.md
CreditMera_*.zip
docs/
scripts/docgen/

