# ==============================================================================
# CreditMera Configuration (.env.example)
# Copy this file to .env and adjust variables for your local or production setup.
# Never commit the actual .env file with production secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=CreditMera
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Security & Secrets
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=creditmera_insecure_dev_secret_change_in_production_32bytes_min
WATERMARK_SECRET_KEY=creditmera_master_watermark_key_change_in_prod
ALGORITHM_VERSION=v1.0-dct-svd

# Database Configuration
# For local development without PostgreSQL, SQLite can be used: sqlite:///./creditmera.db
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/creditmera
DATABASE_URL=sqlite:///./creditmera.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/creditmera

# Storage Configuration
# Options: local, s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage_data
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,tiff

# Watermark Engine Parameters
DEFAULT_WATERMARK_ALPHA=0.10
WATERMARK_BLOCK_SIZE=8
PAYLOAD_NUM_BITS=64

# Auth & Token Lifetime
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RECEIPT_ISSUER="CreditMera Ownership Authority v1.0"
MAX_IMAGE_DIMENSION=8192
MIN_IMAGE_DIMENSION=64

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment Variables (used by Vite)
VITE_API_BASE_URL=http://localhost:8000
